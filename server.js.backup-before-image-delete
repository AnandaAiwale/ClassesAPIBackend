            student.password_hash
        );

        if (!passwordValid) {
            return res.status(401).json({
                success: false,
                message: "Invalid email, class or password"
            });
        }

        const token = jwt.sign(
            {
                id: student.id,
                role: "student",
                teacherId: student.teacher_id
            },
            process.env.JWT_SECRET,
            {
                expiresIn: "7d"
            }
        );

