app.delete("/api/homework/:homeworkId", authenticateToken, async (req, res) => {
    try {
        const { homeworkId } = req.params;
        const teacherId = req.user.teacherId;

        // Get homework and verify ownership
        const homeworkResult = await pool.query(
            `SELECT id
             FROM homework
             WHERE id = $1
             AND teacher_id = $2`,
            [homeworkId, teacherId]
        );

        if (homeworkResult.rows.length === 0) {
            return res.status(404).json({
                success: false,
                message: "Homework not found"
            });
        }

        // Get image files before deleting database records
        const imagesResult = await pool.query(
            `SELECT image_url
             FROM homework_images
             WHERE homework_id = $1`,
            [homeworkId]
        );

        // Delete homework
        // homework_images will be deleted automatically
        // because of ON DELETE CASCADE.
        await pool.query(
            `DELETE FROM homework
             WHERE id = $1
             AND teacher_id = $2`,
            [homeworkId, teacherId]
        );

        // Delete physical image files
        for (const image of imagesResult.rows) {
            if (image.image_url) {
                const relativePath = image.image_url.replace(/^\/uploads\//, "");
                const filePath = path.join(__dirname, "uploads", relativePath);

                if (fs.existsSync(filePath)) {
                    fs.unlinkSync(filePath);
                }
            }
        }

        return res.status(200).json({
            success: true,
            message: "Homework deleted successfully"
        });

    } catch (error) {
        console.error("Delete homework error:", error);

        return res.status(500).json({
            success: false,
            message: "Server error"
        });
    }
});


