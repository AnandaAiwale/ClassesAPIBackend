                 AND teacher_id = $2`,
                [homeworkId, teacherId]
            );

            if (homeworkResult.rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: "Homework not found"
                });
            }

            // Check image was uploaded
            if (!req.file) {
                return res.status(400).json({
                    success: false,
                    message: "Image is required"
                });
            }

            // Check maximum 5 images
            const countResult = await pool.query(
                `SELECT COUNT(*)::int AS image_count
                 FROM homework_images
                 WHERE homework_id = $1`,
                [homeworkId]
            );

            const imageCount = countResult.rows[0].image_count;

            if (imageCount >= 5) {

                // Remove uploaded file because limit exceeded
                fs.unlinkSync(req.file.path);

                return res.status(400).json({
                    success: false,
                    message: "Maximum 5 images allowed for this homework date"
                });
            }

            const imageId = crypto.randomUUID();
            const imageOrder = imageCount + 1;
            const now = Date.now();

            const imageUrl =
                `/uploads/homework/${req.file.filename}`;

            const result = await pool.query(
                `INSERT INTO homework_images (
                    id,
                    homework_id,
                    image_url,
                    file_name,
                    image_order,
                    created_at
                )
                VALUES ($1, $2, $3, $4, $5, $6)
