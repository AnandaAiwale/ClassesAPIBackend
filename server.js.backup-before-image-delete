// DELETE TEACHER ACCOUNT AND ALL RELATED DATA
app.delete("/api/auth/account", authenticateToken, async (req, res) => {
    const client = await pool.connect();

    try {
        const teacherId = req.user.teacherId;

        // Get homework image files before database deletion
        const imagesResult = await client.query(
            `SELECT hi.image_url
             FROM homework_images hi
             INNER JOIN homework h
                 ON h.id = hi.homework_id
             WHERE h.teacher_id = $1`,
            [teacherId]
        );

        // Check teacher exists
        const teacherResult = await client.query(
            `SELECT id
             FROM teachers
             WHERE id = $1`,
            [teacherId]
        );

        if (teacherResult.rows.length === 0) {
            return res.status(404).json({
                success: false,
                message: "Teacher account not found"
            });
        }

        await client.query("BEGIN");

        // Delete teacher.
        // Database ON DELETE CASCADE removes:
        // students
        // attendance
        // homework
        // homework_images
        const deleteResult = await client.query(
            `DELETE FROM teachers
             WHERE id = $1
             RETURNING id`,
            [teacherId]
        );

        if (deleteResult.rows.length === 0) {
            await client.query("ROLLBACK");

            return res.status(404).json({
                success: false,
                message: "Teacher account not found"
            });
        }

        await client.query("COMMIT");

        // Delete physical homework image files
        for (const image of imagesResult.rows) {
            if (!image.image_url) {
                continue;
            }

            const relativePath = image.image_url.replace(
                /^\/uploads\//,
                ""
            );

            const filePath = path.join(
                __dirname,
                "uploads",
                relativePath
            );

            try {
                if (fs.existsSync(filePath)) {
                    fs.unlinkSync(filePath);
                }
            } catch (fileError) {
                console.error(
                    "Failed to delete homework image:",
                    filePath,
                    fileError
                );
            }
        }

        return res.status(200).json({
            success: true,
            message: "Teacher account and all related data deleted successfully"
        });

    } catch (error) {
        try {
            await client.query("ROLLBACK");
        } catch (rollbackError) {
            console.error("Rollback error:", rollbackError);
        }

        console.error("Delete teacher account error:", error);

        return res.status(500).json({
            success: false,
            message: "Server error"
        });

    } finally {
        client.release();
    }
});

