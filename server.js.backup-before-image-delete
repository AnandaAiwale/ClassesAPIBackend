        const result = await pool.query(
            `SELECT
                s.id,
                s.teacher_id,
                s.student_name,
                s.parent_name,
                s.mobile,
                s.roll_number,
                s.email,
                s.password_hash,
                s.photo_url,
                t.name AS teacher_name,
                t.email AS teacher_email,
                t.mobile AS teacher_mobile,
                t.class_name AS teacher_class_name
             FROM students s
             JOIN teachers t
               ON t.id = s.teacher_id
             WHERE s.email = $1
               AND t.class_name = $2`,
            [email, className]
        );

        if (result.rows.length === 0) {
            return res.status(401).json({
