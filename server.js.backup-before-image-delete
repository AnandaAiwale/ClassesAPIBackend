// ===============================
// EDIT STUDENT
// ===============================
app.put("/api/students/:id", authenticateToken, async (req, res) => {
    try {
        const { id } = req.params;

        const {
            studentName,
            parentName,
            mobile,
            rollNumber,
            username,
            password,
            photoUrl
        } = req.body;

        // Check if student exists and belongs to logged-in teacher
        const studentResult = await pool.query(
            `SELECT id, teacher_id
             FROM students
             WHERE id = $1 AND teacher_id = $2`,
            [id, req.user.id]
        );

        if (studentResult.rows.length === 0) {
            return res.status(404).json({
                success: false,
                message: "Student not found"
            });
        }

        // Build update fields dynamically
        const fields = [];
        const values = [];
        let index = 1;

        if (studentName !== undefined) {
            fields.push(`student_name = $${index++}`);
            values.push(studentName);
        }

        if (parentName !== undefined) {
            fields.push(`parent_name = $${index++}`);
            values.push(parentName);
        }

        if (mobile !== undefined) {
            fields.push(`mobile = $${index++}`);
            values.push(mobile);
        }

        if (rollNumber !== undefined) {
            fields.push(`roll_number = $${index++}`);
            values.push(rollNumber);
        }

        if (username !== undefined) {
            fields.push(`username = $${index++}`);
            values.push(username);
        }

        if (photoUrl !== undefined) {
            fields.push(`photo_url = $${index++}`);
            values.push(photoUrl);
        }

        // Only update password if a new password is provided
        if (password !== undefined && password !== "") {
            const passwordHash = await bcrypt.hash(password, 10);

            fields.push(`password_hash = $${index++}`);
            values.push(passwordHash);
        }

        if (fields.length === 0) {
            return res.status(400).json({
                success: false,
                message: "No fields provided for update"
            });
        }

        values.push(id);
        values.push(req.user.id);

        const result = await pool.query(
            `UPDATE students
             SET ${fields.join(", ")}
             WHERE id = $${index++}
             AND teacher_id = $${index}
             RETURNING
                id,
                teacher_id,
                student_name,
                parent_name,
                mobile,
                roll_number,
                username,
                photo_url,
                created_at`,
            values
        );

        return res.json({
            success: true,
            message: "Student updated successfully",
            student: result.rows[0]
        });

    } catch (error) {
        console.error("Edit student error:", error);

        // Duplicate username
        if (error.code === "23505") {
            return res.status(409).json({
                success: false,
                message: "This email is already registered for a student in your class."
            });
        }

        return res.status(500).json({
            success: false,
            message: "Server error"
        });
    }
});


