            },
            teacher: {
                name: student.teacher_name,
                email: student.teacher_email,
                mobile: student.teacher_mobile,
                className: student.teacher_class_name
            }
        });

    } catch (error) {
        console.error("Student login error:", error);

        return res.status(500).json({
            success: false,
            message: "Server error"
        });
    }
});




