const crypto = require("crypto");

const repository = require("./admin.repository");
const pool = require("../../config/database");

const { hashPassword, comparePassword } = require("../../utils/password");

const { generateToken } = require("../../utils/jwt");



const OTP_SERVICE_URL = "http://127.0.0.1:8000";



async function createAdmin({ name, email, password, mobile = "" }) {

    const existingAdmin = await repository.findByEmail(email);



    if (existingAdmin) {

        const error = new Error("Admin email already exists");

        error.statusCode = 409;

        throw error;

    }



    const passwordHash = await hashPassword(password);

    const now = Date.now();



    const admin = await repository.createAdmin({

        id: crypto.randomUUID(),

        name,

        email,

        passwordHash,

        mobile,

        createdAt: now

    });



    return admin;

}



async function login(email, password) {

    const admin = await repository.findByEmail(email);



    if (!admin) {

        const error = new Error("Invalid email or password");

        error.statusCode = 401;

        throw error;

    }



    if (!admin.is_active) {

        const error = new Error("Admin account is inactive");

        error.statusCode = 403;

        throw error;

    }



    const validPassword = await comparePassword(

        password,

        admin.password_hash

    );



    if (!validPassword) {

        const error = new Error("Invalid email or password");

        error.statusCode = 401;

        throw error;

    }



    return createAdminToken(admin);

}



async function sendOtp(email, purpose = "login") {
    const normalizedEmail = String(email || "").trim().toLowerCase();

    if (!["registration", "login"].includes(purpose)) {
        const error = new Error("Purpose must be registration or login");
        error.statusCode = 400;
        throw error;
    }

    const admin = await repository.findByEmail(normalizedEmail);

    if (purpose === "login") {
        if (!admin) {
            const error = new Error("Admin email not found");
            error.statusCode = 404;
            throw error;
        }

        if (!admin.is_active) {
            const error = new Error("Admin account is inactive");
            error.statusCode = 403;
            throw error;
        }
    }

    const response = await fetch(`${OTP_SERVICE_URL}/send-otp`, {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({
            email: normalizedEmail,
            purpose
        })
    });

    const data = await response.json();

    if (!response.ok || !data.success) {
        const error = new Error(
            data.detail || data.message || "Failed to send OTP"
        );
        error.statusCode = response.status >= 400 && response.status < 500
            ? response.status
            : 502;
        throw error;
    }

    return {
        message: "OTP sent successfully"
    };
}

async function verifyOtp(email, otp, purpose = "login") {
    if (purpose !== "login") {
        const error = new Error(
            "Use the registration verification endpoint for registration OTPs"
        );
        error.statusCode = 400;
        throw error;
    }

    const normalizedEmail = String(email || "").trim().toLowerCase();
    const admin = await repository.findByEmail(normalizedEmail);

    if (!admin) {
        const error = new Error("Admin email not found");
        error.statusCode = 404;
        throw error;
    }

    if (!admin.is_active) {
        const error = new Error("Admin account is inactive");
        error.statusCode = 403;
        throw error;
    }

    const response = await fetch(`${OTP_SERVICE_URL}/verify-otp`, {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({
            email: normalizedEmail,
            otp,
            purpose: "login"
        })
    });

    const data = await response.json();

    if (!response.ok || !data.success) {
        const error = new Error(
            data.detail || data.message || "Invalid or expired OTP"
        );
        error.statusCode = response.status >= 400 && response.status < 500
            ? response.status
            : 502;
        throw error;
    }

    return createAdminToken(admin);
}


async function verifyRegistrationOtp({ email, otp, name, password, mobile = "" }) {
    const normalizedEmail = String(email || "").trim().toLowerCase();

    // Consume and verify an OTP issued specifically for registration.
    const response = await fetch(`${OTP_SERVICE_URL}/verify-otp`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
            email: normalizedEmail,
            otp,
            purpose: "registration"
        })
    });

    const otpResult = await response.json();

    if (!response.ok || !otpResult.success) {
        const error = new Error(
            otpResult.detail || otpResult.message || "Invalid or expired registration OTP"
        );
        error.statusCode = response.status >= 400 && response.status < 500
            ? response.status
            : 502;
        throw error;
    }

    const passwordHash = await hashPassword(password);
    const client = await pool.connect();

    try {
        await client.query("BEGIN");

        const existing = await client.query(
            "SELECT id FROM admins WHERE LOWER(email) = LOWER($1) LIMIT 1",
            [normalizedEmail]
        );

        if (existing.rowCount > 0) {
            const error = new Error("Email already registered. Please log in.");
            error.statusCode = 409;
            throw error;
        }

        const admin = await repository.createAdminWithClient(client, {
            id: crypto.randomUUID(),
            name: String(name).trim(),
            email: normalizedEmail,
            passwordHash,
            mobile: String(mobile || "").trim(),
            createdAt: Date.now()
        });

        await client.query("COMMIT");

        return {
            admin_uid: admin.admin_uid,
            email: admin.email
        };
    } catch (error) {
        await client.query("ROLLBACK").catch(() => {});
        if (error.code === "23505") {
            const conflict = new Error("Email already registered. Please log in.");
            conflict.statusCode = 409;
            throw conflict;
        }
        throw error;
    } finally {
        client.release();
    }
}

function createAdminToken(admin) {

    const token = generateToken({

        id: admin.id,

        role: "admin",

        email: admin.email

    });



    return {

        token,

        admin: {

            id: admin.id,
            admin_uid: admin.admin_uid,

            name: admin.name,

            email: admin.email,

            mobile: admin.mobile,

            isActive: admin.is_active

        }

    };

}



async function getProfile(adminId) {

    const admin = await repository.findById(adminId);



    if (!admin) {

        const error = new Error("Admin not found");

        error.statusCode = 404;

        throw error;

    }



    return {

        id: admin.id,

        name: admin.name,

        email: admin.email,

        mobile: admin.mobile,

        isActive: admin.is_active,

        createdAt: admin.created_at,

        updatedAt: admin.updated_at

    };

}



async function updateProfile(adminId, { name, email, mobile = "" }) {

    const admin = await repository.findById(adminId);



    if (!admin) {

        const error = new Error("Admin not found");

        error.statusCode = 404;

        throw error;

    }



    const existingAdmin = await repository.findByEmail(email);



    if (existingAdmin && existingAdmin.id !== adminId) {

        const error = new Error("Admin email already exists");

        error.statusCode = 409;

        throw error;

    }



    const updatedAdmin = await repository.updateProfile({

        id: adminId,

        name,

        email,

        mobile,

        updatedAt: Date.now()

    });



    return {

        id: updatedAdmin.id,

        name: updatedAdmin.name,

        email: updatedAdmin.email,

        mobile: updatedAdmin.mobile,

        isActive: updatedAdmin.is_active,

        createdAt: updatedAdmin.created_at,

        updatedAt: updatedAdmin.updated_at

    };

}



async function changePassword(adminId, currentPassword, newPassword) {

    const admin = await repository.findById(adminId);



    if (!admin) {

        const error = new Error("Admin not found");

        error.statusCode = 404;

        throw error;

    }



    const validPassword = await comparePassword(

        currentPassword,

        admin.password_hash

    );



    if (!validPassword) {

        const error = new Error("Current password is incorrect");

        error.statusCode = 401;

        throw error;

    }



    const passwordHash = await hashPassword(newPassword);



    await repository.updatePassword({

        id: adminId,

        passwordHash,

        updatedAt: Date.now()

    });



    return {

        message: "Password changed successfully"

    };

}



module.exports = {
    verifyRegistrationOtp,

    createAdmin,

    login,

    sendOtp,

    verifyOtp,

    getProfile,

    updateProfile,

    changePassword

};
