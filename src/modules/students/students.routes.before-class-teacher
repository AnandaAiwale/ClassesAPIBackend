const express = require("express");
const controller = require("./students.controller");
const { requireTeacher } = require("../../middleware/teacherAuth");
const {
    requireClassTeacher,
    requireOwnClass
} = require("../../middleware/classTeacherAuth");

const router = express.Router();

router.get(
    "/class/:classId",
    requireTeacher,
    requireClassTeacher,
    requireOwnClass,
    controller.getStudentsByClass
);

router.get(
    "/:id",
    requireTeacher,
    requireClassTeacher,
    controller.getStudentById
);

router.post(
    "/",
    requireTeacher,
    requireClassTeacher,
    requireOwnClass,
    controller.createStudent
);

router.put(
    "/:id",
    requireTeacher,
    requireClassTeacher,
    controller.updateStudent
);

router.patch(
    "/:id/status",
    requireTeacher,
    requireClassTeacher,
    controller.updateStudentStatus
);

router.patch(
    "/:id/password",
    requireTeacher,
    requireClassTeacher,
    controller.updateStudentPassword
);

router.delete(
    "/:id",
    requireTeacher,
    requireClassTeacher,
    controller.deleteStudent
);

module.exports = router;
