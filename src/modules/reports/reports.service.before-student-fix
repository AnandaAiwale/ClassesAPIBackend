async function getClassTeacherAttendanceReport(
    teacherId,
    fromDate,
    toDate
) {
    validateDateRange(fromDate, toDate);

    const assignments =
        await teacherAssignmentsRepository.findByTeacher(
            teacherId
        );

    const classTeacherAssignment =
        assignments.find(
            (assignment) =>
                assignment.is_class_teacher &&
                assignment.is_active
        );

    if (!classTeacherAssignment) {
        throw new Error(
            "Teacher is not assigned as a Class Teacher"
        );
    }

    return reportsRepository.getAttendanceSummaryByClass(
        classTeacherAssignment.class_id,
        fromDate,
        toDate
    );
}

