const reportsRepository = require("./reports.repository");
const classesRepository = require("../classes/classes.repository");
const studentsRepository = require("../students/students.repository");
const teacherAssignmentsRepository = require("../teacherAssignments/teacherAssignments.repository");

function validateDate(date) {
    return /^\d{4}-\d{2}-\d{2}$/.test(date);
}

function validateDateRange(fromDate, toDate) {
    if (!fromDate || !toDate) {
        throw new Error("fromDate and toDate are required");
    }

    if (!validateDate(fromDate) || !validateDate(toDate)) {
        throw new Error(
            "Dates must be in YYYY-MM-DD format"
        );
    }

    if (fromDate > toDate) {
        throw new Error(
            "fromDate cannot be greater than toDate"
        );
    }
}

async function getClassAttendanceReport(
    classId,
    fromDate,
    toDate
) {
    validateDateRange(fromDate, toDate);

    const classItem =
        await classesRepository.findById(classId);

    if (!classItem) {
        throw new Error("Class not found");
    }

    return reportsRepository.getAttendanceByClass(
        classId,
        fromDate,
        toDate
    );
}

