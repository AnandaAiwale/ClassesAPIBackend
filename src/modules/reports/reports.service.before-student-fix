async function getStudentAttendanceReport(studentId) {
    const student =
        await studentsRepository.findById(studentId);

    if (!student || !student.is_active) {
        throw new Error(
            "Student not found or inactive"
        );
    }

    return reportsRepository.getAttendanceSummaryByClass(
        student.class_id,
        "0000-01-01",
        "9999-12-31"
    );
}

